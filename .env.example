# Local development only; copy to .env. Never use this password for deployment.
POSTGRES_PASSWORD=reviewbridge_local
API_PORT=8000
# Minimum seconds between sync jobs of one connection.
SYNC_COOLDOWN_SECONDS=300
# How often the worker syncs each active connection automatically.
SYNC_INTERVAL_HOURS=12
# DEBUG also logs container health checks.
LOG_LEVEL=INFO
# Requests per minute, per token: review feeds, token issuance, everything else.
RATE_LIMIT_FEED_PER_MINUTE=300
RATE_LIMIT_TOKENS_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120
